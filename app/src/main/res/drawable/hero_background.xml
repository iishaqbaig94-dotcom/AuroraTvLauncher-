<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#050817"
                android:centerColor="#111D48"
                android:endColor="#35106A"
                android:angle="0"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <stroke
                android:width="2dp"
                android:color="#554B9CFF"/>
        </shape>
    </item>

</layer-list>
