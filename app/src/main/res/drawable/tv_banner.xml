<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep space background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#030611"
                android:centerColor="#101B42"
                android:endColor="#260B50" />
        </shape>
    </item>

    <!-- Blue infinity glow -->
    <item
        android:width="220dp"
        android:height="150dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#6630BFFF"
                android:centerColor="#22205AFF"
                android:endColor="#0030BFFF" />
        </shape>
    </item>

    <!-- Violet glow -->
    <item
        android:width="150dp"
        android:height="120dp"
        android:gravity="right|center_vertical">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerColor="#554F16B8"
                android:endColor="#004F16B8" />
        </shape>
    </item>

    <!-- Bottom cinematic shadow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:endColor="#CC030611" />
        </shape>
    </item>

</layer-list>

